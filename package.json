{
	"name": "multicam-systems-rcp",
	"version": "1.1.0-beta.2",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "yarn build && companion-module-build",
		"build": "rimraf dist && yarn build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "yarn lint:raw .",
		"test": "yarn build:main && node --test test-api.mjs test-presets.mjs"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-multicam-systems-rcp.git"
	},
	"engines": {
		"node": "^22.20 || ^26.5",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~1.13.6",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^2.8.0",
		"@types/node": "^22.18.13",
		"@types/ws": "^8.18.1",
		"eslint": "^9.39.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.6",
		"prettier": "^3.8.1",
		"rimraf": "^6.1.0",
		"tsx": "^4.23.13",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.56.1"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		]
	},
	"packageManager": "yarn@4.10.3",
	"resolutions": {
		"ws": "^8.17.1"
	}
}
